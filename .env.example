# Keep this file public. Put real values only in the ignored .env file.
# Authentication remains disabled until both a provider and AUTH_ENABLED=true are set.
AUTH_ENABLED=false
AUTH_SESSION_SECRET=replace-with-a-random-value-of-at-least-32-characters
AUTH_PUBLIC_URL=http://localhost:8000
AUTH_COOKIE_SECURE=false

# Either provide the two variables below, or keep exactly one Google web-client
# JSON file in data/client_secret_*.json (recommended for local testing).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CREDENTIALS_FILE=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
